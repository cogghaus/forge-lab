# forge-dash-community — environment example
# Copy to .env.local and fill in values.

# URL of the forge Hub API (forge-server).
FORGE_HUB_URL=http://localhost:3000

# Absolute path to the forge-lab workdir.
# The SSE log-stream route reads agent log files from:
#   ${FORGE_WORKDIR}/context/agent-logs/{taskId}.log
# and checks for task completion at:
#   ${FORGE_WORKDIR}/.forge/tasks/{taskId}.done
#
# Defaults to process.cwd() when unset (suitable for monorepo dev where the
# Next.js server runs from the repo root).
FORGE_WORKDIR=
