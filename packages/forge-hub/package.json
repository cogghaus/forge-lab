{
  "name": "@forge-lab/hub",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify hub server for forge-lab",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forge-hub": "./dist/bin/forge-hub.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/bin/forge-hub.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/websocket": "^11.0.2",
    "@forge-lab/core": "workspace:*",
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.37.0",
    "fastify": "^5.2.0",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
