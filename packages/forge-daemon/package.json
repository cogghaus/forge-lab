{
  "name": "@forge-lab/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "Local daemon bridging hub, runtimes, and agents for forge-lab",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forge-daemon": "./dist/bin/forge-daemon.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx --env-file=.env watch src/bin/forge-daemon.ts"
  },
  "dependencies": {
    "@forge-lab/agents": "workspace:*",
    "@forge-lab/core": "workspace:*",
    "nanoid": "^5.0.9",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@forge-lab/hub": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "drizzle-orm": "^0.37.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
