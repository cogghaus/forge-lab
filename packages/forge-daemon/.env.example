# forge-daemon environment variables
# Copy to .env and fill in required values.

# Required
FORGE_DAEMON_HUB_URL=http://localhost:3000
FORGE_DAEMON_DEVICE_TOKEN=<token from POST /devices>

# Optional — defaults shown
FORGE_DAEMON_WORKDIR=.                        # working directory for task files; defaults to cwd
FORGE_DAEMON_DEFAULT_RUNTIME=background       # mock | claude-code | background
FORGE_DAEMON_AGENT_ID=architect               # personality id from @forge-lab/agents
# FORGE_DAEMON_SKIP_PERMISSIONS=false         # unset/empty = true (default); set to false to disable --dangerously-skip-permissions
FORGE_DAEMON_WORKSPACE_ID=                    # scope to one workspace; leave blank for global
