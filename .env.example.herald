# Herald worker daemon — copy to .env.herald and fill in the values below.
# Claims tasks with assignedAgentId=herald.
# Role: notifications, status updates, external integrations.

# Hub API URL (required)
FORGE_DAEMON_HUB_URL=http://localhost:3000

# Device token registered in the hub with deviceType=worker (required).
# Register via: POST /devices
#   { "name": "forge-herald", "agentId": "herald", "deviceType": "worker" }
# Copy the returned token here.
FORGE_DAEMON_DEVICE_TOKEN=

# Workspace scope (recommended). When set, daemon only claims tasks from this
# workspace. Omit for global worker mode (claims tasks from all workspaces).
FORGE_DAEMON_WORKSPACE_ID=

# Agent identifier — determines which tasks this daemon claims.
FORGE_DAEMON_AGENT_ID=herald

# Working directory for task files and agent logs.
FORGE_DAEMON_WORKDIR=./forge-workdir

# Runtime used to spawn the agent process.
FORGE_DAEMON_DEFAULT_RUNTIME=background

# Skip permission prompts (true for unattended operation).
FORGE_DAEMON_SKIP_PERMISSIONS=true

# Maximum concurrent tasks. Increase for parallel work (e.g., 2 or 3).
FORGE_DAEMON_MAX_CONCURRENT_TASKS=1
