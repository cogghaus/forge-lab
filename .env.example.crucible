# Crucible worker daemon — copy to .env.crucible and fill in the values below.
# Claims tasks with assignedAgentId=crucible (QA: tests, coverage, bug repro).

FORGE_DAEMON_HUB_URL=http://localhost:3001

# Register via: POST /devices/register
#   { "name": "forge-crucible", "agentId": "crucible", "deviceType": "worker" }
FORGE_DAEMON_DEVICE_TOKEN=

FORGE_DAEMON_WORKSPACE_ID=
FORGE_DAEMON_AGENT_ID=crucible
FORGE_DAEMON_WORKDIR=./forge-workdir
FORGE_DAEMON_DEFAULT_RUNTIME=background
FORGE_DAEMON_SKIP_PERMISSIONS=true
FORGE_DAEMON_MAX_CONCURRENT_TASKS=1
