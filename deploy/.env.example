# forge-lab production secrets
# Copy to your own env file outside the repo, fill in values, and pass it
# with --env-file. Never commit a filled-in copy.
# Never commit this file with real values.

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORGE_HUB_SESSION_SECRET=change_this_to_a_64_char_hex_string
RESEND_API_KEY=re_your_api_key_here
APP_BASE_URL=https://forge.example.com

# forge-mcp
FORGE_MCP_EMAIL=mcp@example.com
FORGE_MCP_PASSWORD=your_admin_password_here
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORGE_MCP_API_KEY=generate_random_key_here

# --- Deployment layout -------------------------------------------------
# Host directory holding data/ (SQLite DB) and workdir/ (agent logs).
FORGE_DATA_ROOT=/srv/forge-lab
# Public hostnames used by the Traefik routers.
FORGE_DASH_HOST=forge.example.com
FORGE_MCP_HOST=mcp.forge.example.com
# Optional: overrides the From address on hub-sent email.
# FORGE_HUB_MAIL_FROM=Forge Lab <noreply@example.com>
