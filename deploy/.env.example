# forge-lab production secrets
# Copy to /datapool/docker/vibe-forge/.env and fill in values.
# Never commit this file with real values.

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORGE_HUB_SESSION_SECRET=change_this_to_a_64_char_hex_string
RESEND_API_KEY=re_your_api_key_here
APP_BASE_URL=https://lab.local.cogg.haus
