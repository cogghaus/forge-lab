# Scribe worker daemon — copy to .env.scribe and fill in the values below.
# Claims tasks with assignedAgentId=scribe (knowledge base: doc creation, audit, supersede).
# Phase 4: Scribe will also run in reactive completion-listener mode.

FORGE_DAEMON_HUB_URL=http://localhost:3000

# Register via: POST /devices
#   { "name": "forge-scribe", "agentId": "scribe", "deviceType": "worker" }
FORGE_DAEMON_DEVICE_TOKEN=

FORGE_DAEMON_WORKSPACE_ID=
FORGE_DAEMON_AGENT_ID=scribe
FORGE_DAEMON_WORKDIR=./forge-workdir
FORGE_DAEMON_DEFAULT_RUNTIME=background
FORGE_DAEMON_SKIP_PERMISSIONS=true
FORGE_DAEMON_MAX_CONCURRENT_TASKS=1
