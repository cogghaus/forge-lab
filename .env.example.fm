# FM Orchestrator daemon — copy to .env.fm and fill in the values below.
# This daemon runs in dispatcher mode: it detects pending_dispatcher_action
# tasks, spawns the Forge Master agent to triage them, and does not claim
# worker tasks.

# Hub API URL (required)
FORGE_DAEMON_HUB_URL=http://localhost:3001

# Device token registered in the hub with deviceType=orchestrator (required).
# Register via: POST /devices/register
#   { "name": "forge-fm", "agentId": "forge-master", "deviceType": "orchestrator" }
# Copy the returned token here.
FORGE_DAEMON_DEVICE_TOKEN=

# Workspace to orchestrate (required for dispatcher mode).
FORGE_DAEMON_WORKSPACE_ID=

# FM agent identifier — must match the agentId registered in the agents table.
FORGE_DAEMON_AGENT_ID=forge-master

# Enable dispatcher mode (required for FM daemon — do not change).
FORGE_DAEMON_DISPATCHER_MODE=true

# Stale assignment TTL: tasks assigned but not claimed within this many minutes
# are requeued back to pending_dispatcher_action. Default: 30.
FORGE_DAEMON_STALE_TTL_MINUTES=30

# Working directory for FM task files and logs.
FORGE_DAEMON_WORKDIR=./forge-workdir

# Runtime used to spawn the FM agent process.
FORGE_DAEMON_DEFAULT_RUNTIME=background

# Skip permission prompts (true for unattended FM operation).
FORGE_DAEMON_SKIP_PERMISSIONS=true
