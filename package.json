{
  "name": "forge-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-core multi-agent orchestration for AI-assisted development",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sugar-crash-studios/forge-lab.git"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "turbo": "^2.9.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
